# /home/sol/agave-cpu-layout.env (FRA), read by agave-cpu-layout.service (pin_layout.py).
# agave on 0-7,24-29; PoH tick producer on 30 as SCHED_IDLE (a non-voting node never leads);
# Yellowstone's busy-polling delivery worker on 31 (it also pins itself, plugin `affinity`);
# shredstream proxy on agave's CPUs. The fast lane pins its own threads (fast_lane.toml).
# The bot partition 15-23,39-47 is left alone.
AGAVE_CPUS=0-7,24-29
POH_CPUS=30
POH_IDLE=1
GRPCX_CPUS=31
PROXY_CPUS=0-7,24-29
